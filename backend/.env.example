NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
# Optional when the backend serves the frontend from a non-default location.
FRONTEND_DIST_PATH=

# Use a local MongoDB instance or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/leadfinder
JWT_SECRET=replace-with-a-long-random-secret

# FastAPI lead-source service. Leave LEADS_API_URL blank to use the Google
# Places connector (if configured) or the built-in demo data.
LEADS_API_URL=http://localhost:8000/search
LEADS_API_KEY=use-the-same-secret-as-fastapi

# Optional alternative lead source when LEADS_API_URL is blank.
GOOGLE_MAPS_API_KEY=

# Optional integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
